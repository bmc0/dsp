# Example:
#     Upmix 2-channel audio to 2/2 surround using matrix4_mb with
#     direct_path enabled.
# Input channel map:
#     0: Left
#     1: Right
# Output channel map:
#     0: Front Left
#     1: Front Right
#     2: Surround Left
#     3: Surround Right

matrix4_mb signal,matrix=v4:1,direct_path,rear_event_mask=0 -3/0
:2,3 {
	# delayed path
	delay -m3.1m -b0.5 5m decorrelate -s1 -m -f0.7k -l35m 5
	lowshelf 11 2s -5 allpass 80 0.6 allpass 25 0.8
} :
:4,5 {
	# direct path
	delay -6m
} :
remix 0 1 2,4 3,5
