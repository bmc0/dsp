# Example:
#     Upmix 2-channel audio to 2/4 surround using matrix4_mb with
#     direct_path enabled.
# Input channel map:
#     0: Left
#     1: Right
# Output channel map:
#     0: Front Left
#     1: Front Right
#     2: Side Left
#     3: Side Right
#     4: Rear Left
#     5: Rear Right

matrix4_mb signal,layout=2/4,matrix=v4:1,direct_path,rear_event_mask=0 -3/0
:2-5 {
	# delayed path
	delay -m3.1m -b0.5 5m decorrelate -s1 -m -f0.7k -l35m 5 lowshelf 11 2s -8 allpass 80 0.6
	:2,3 delay 2m decorrelate -s7 -m -f0.7k -l35m 5 allpass 80 0.6 allpass 25 0.8 :
} :
:6-9 {
	# direct path
	:0,1 delay -3m :2,3 delay -9m :
} :
remix 0 1 2,6 3,7 4,8 5,9
