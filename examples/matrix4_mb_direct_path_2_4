# Example:
#     Upmix 2-channel audio to 2/4 surround using matrix4_mb with
#     direct_path enabled.
# Input channel map:
#     0: Left
#     1: Right
# Output channel map:
#     0: Left Front
#     1: Right Front
#     2: Left Side
#     3: Right Side
#     4: Left Rear
#     5: Right Rear

matrix4_mb signal,layout=2/4,matrix=v4:0.39:1,direct_path,rear_event_mask=0
:2-5 {
	# delayed path
	delay -m3.1m -b0.5 5m decorrelate -s1 -m -f0.7k -l35m 5 allpass 80 0.6
	:2,3 delay 2m decorrelate -s7 -m -f0.7k -l35m 5 allpass 80 0.6 allpass 25 0.8 :
} :
:6-9 {
	# direct path
	delay -6m
} :
remix 0 1 2,6 3,7 4,8 5,9
