# Example:
#     Upmix 2-channel audio to 2/4 surround using matrix4_mb with
#     direct_path enabled. Sounds which are strongly surround encoded
#     are sent to the rear outputs only.
# Input channel map:
#     0: Left
#     1: Right
# Output channel map:
#     0: Front Left
#     1: Front Right
#     2: Side Left
#     3: Side Right
#     4: Rear Left
#     5: Rear Right

matrix4_mb signal,matrix=v4:1,direct_path,rear_event_mask=0 -3/0
:2-5 {
	:0,1 {
		delay -10m decorrelate -s1 -m -f0.7k -l35m 5 lowshelf 11 2s -8 allpass 80 0.6
		gain -3 remix 0 1 0 1
		:2,3 delay 2m decorrelate -s7 -m -f0.7k -l35m 5 allpass 80 0.6 allpass 25 0.8 :
		delay -m3.1m -b0.5 0
	} :
	:2,3 delay -6m :
	remix 0 1 2,4 3,5
} :
